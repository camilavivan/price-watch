# 复制为 .env 后填写（勿提交 .env）

# QQ 官方开放平台（必填，给 bot 服务）
QQ_BOT_APP_ID=
QQ_BOT_SECRET=
# QQ_BOT_SANDBOX=1
# QQ_BOT_SEND_IMAGES=1

# 管理 Token（建议设置；Web Cookie / X-Admin-Token / bot↔app）
# ADMIN_TOKEN=change-me

# 内部地址（compose 内一般不用改）
# APP_API_BASE=http://app:8080
# BOT_NOTIFY_URL=http://bot:8091/notify

# 数据库
# DATABASE_URL=sqlite+aiosqlite:///./data/pricewatch.db

LOG_LEVEL=info

# ---- 构建代理 / 镜像（解决 pip/npm 超时）----
# 方案 A（推荐国内服务器）：用镜像，一般不用代理
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
# NPM_REGISTRY=https://registry.npmmirror.com

# 方案 B：宿主机已开 Clash/V2Ray HTTP 端口时（允许局域网连接）
# Docker 构建容器访问宿主机代理用 host.docker.internal，不要写 127.0.0.1
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,host.docker.internal,.npmmirror.com,.tsinghua.edu.cn
