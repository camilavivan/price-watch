# 复制为 .env 后填写（勿提交 .env）

# QQ 官方开放平台（必填）
QQ_BOT_APP_ID=
QQ_BOT_SECRET=
# QQ_BOT_SANDBOX=1
# QQ_BOT_SEND_IMAGES=1

# 管理 Token（建议设置；Web Cookie / X-Admin-Token / bot↔app）
# ADMIN_TOKEN=change-me

# 单容器内本机互通（compose 默认即可，一般不用改）
# APP_API_BASE=http://127.0.0.1:8080
# BOT_NOTIFY_URL=http://127.0.0.1:8091/notify

# 数据库
# DATABASE_URL=sqlite+aiosqlite:///./data/pricewatch.db

# Web 宿主机端口（默认 8080）
# WEB_PORT=8080

LOG_LEVEL=info

# ---- 构建代理 / 镜像（解决 pip/npm 超时）----
# 方案 A（推荐）：国内 PyPI 镜像（腾讯云主机用腾讯云源；遇 403 换阿里云）
PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
PIP_TRUSTED_HOST=mirrors.cloud.tencent.com
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
# PIP_TRUSTED_HOST=mirrors.aliyun.com
NPM_REGISTRY=https://registry.npmmirror.com

# 方案 B：宿主机已开 Clash/V2Ray HTTP 端口时（允许局域网连接）
# Docker 构建容器访问宿主机代理用 host.docker.internal，不要写 127.0.0.1
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,host.docker.internal,.npmmirror.com,.tsinghua.edu.cn

# ---- 运行时出站代理（京东自动取价 / 短链展开）----
# 云 VPS 直连常被京东风控；可走 ImmortalWrt/Tencent 上 Clash 的 HTTP 端口。
# Docker 访问宿主机代理请用 host.docker.internal（或网关 IP），不要写 127.0.0.1。
# 代理仍可能命中风控；失败时用 QQ「填价 <id> <到手价>」手动填。
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# ALL_PROXY=http://host.docker.internal:7890
# JD_HTTP_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,host.docker.internal

