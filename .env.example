# 复制为 .env 后填写（勿提交 .env）

# QQ 官方开放平台（必填，给 bot 服务）
QQ_BOT_APP_ID=
QQ_BOT_SECRET=
# QQ_BOT_SANDBOX=1
# QQ_BOT_SEND_IMAGES=1

# 管理 Token（建议设置；Web Cookie / X-Admin-Token / bot↔app）
# ADMIN_TOKEN=change-me

# 内部地址（compose 内一般不用改）
# APP_API_BASE=http://app:8080
# BOT_NOTIFY_URL=http://bot:8091/notify

# 数据库
# DATABASE_URL=sqlite+aiosqlite:///./data/pricewatch.db

LOG_LEVEL=info
